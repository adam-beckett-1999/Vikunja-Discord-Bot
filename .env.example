# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Required: IANA timezone used by the bot (e.g. UTC, Europe/London, America/New_York)
TZ=UTC
# Required: Public base URL for the bot (for example https://your-bot.example.com)
BOT_PUBLIC_URL=https://your-bot.example.com

# Vikunja Configuration
VIKUNJA_BASE_URL=https://your-vikunja-instance.example.com
# API token created in Vikunja under Settings → API Tokens
VIKUNJA_API_TOKEN=your_vikunja_api_token_here

# Webhook Configuration
# Optional override for the Express webhook receiver server port
WEBHOOK_PORT=3000
