# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Comma-separated list of guild IDs to register commands in (leave empty for global commands)
DISCORD_GUILD_IDS=

# Vikunja Configuration
VIKUNJA_BASE_URL=https://your-vikunja-instance.example.com
# API token created in Vikunja under Settings → API Tokens
VIKUNJA_API_TOKEN=your_vikunja_api_token_here

# Webhook Configuration
# Port for the Express webhook receiver server
WEBHOOK_PORT=3000
# Secret used to verify that incoming webhooks originate from your Vikunja instance
WEBHOOK_SECRET=your_webhook_secret_here
# Discord channel ID where task notifications will be sent
NOTIFICATION_CHANNEL_ID=your_discord_channel_id_here
